{
  "name": "crave-recipe-app",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --env-file-if-exists=.env server/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "start": "NODE_ENV=production node --env-file-if-exists=.env server/index.js",
    "db:init": "node --env-file-if-exists=.env server/database/init.js",
    "test": "node --test server/*.test.js && vitest run --config client/vite.config.js",
    "test:server": "node --test server/*.test.js",
    "test:client": "vitest run --config client/vite.config.js",
    "test:e2e": "playwright test",
    "format": "prettier --write client/src server tests scripts docs *.json *.js *.md",
    "smoke:live": "node scripts/live-smoke.js"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/dm-serif-display": "^5.3.0",
    "@tailwindcss/vite": "^4.1.0",
    "bcryptjs": "^3.0.2",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "tailwindcss": "^4.1.0",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.10",
    "supertest": "^7.0.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5"
  }
}
